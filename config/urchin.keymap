#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hml: homewrow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT_HAND";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <5 6 7 8 9 9 15 16 17 18 19 25 26 27 28 29 33 32>;
        };

        hmr: homewrow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_RIGHT_HAND";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <0 1 3 4 10 11 12 13 14 20 21 22 23 24 30 31 2>;
            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&lt 4 ESCAPE>;
            key-positions = <30 31>;
        };

        fun_layer {
            bindings = <&lt 2 DELETE>;
            key-positions = <33 32>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp Q            &kp W            &kp E         &kp R            &kp T      &kp Y      &kp U          &kp I         &kp O             &kp P
&hml LEFT_GUI A  &hml LEFT_ALT S  &hml LCTRL D  &hml LSHIFT F    &kp G      &kp H      &hmr RSHIFT J  &hmr RCTRL K  &hmr RIGHT_ALT L  &hmr RIGHT_GUI SEMICOLON
&kp Z            &kp X            &kp C         &kp V            &kp B      &kp N      &kp M          &kp COMMA     &kp PERIOD        &kp SLASH
                                                &lt 3 BACKSPACE  &kp TAB    &kp ENTER  &lt 1 SPACE
            >;
        };

        num {
            bindings = <
&kp GRAVE  &kp N7  &kp N8  &kp N9  &kp BACKSLASH        &trans  &trans  &trans  &trans  &trans
&kp MINUS  &kp N4  &kp N5  &kp N6  &kp LEFT_BRACKET     &trans  &trans  &trans  &trans  &trans
&kp EQUAL  &kp N1  &kp N2  &kp N3  &kp RIGHT_BRACKET    &trans  &trans  &trans  &trans  &trans
                           &kp N0  &trans               &trans  &trans
            >;
        };

        fun {
            bindings = <
&kp F12  &kp F1  &kp F2  &kp F3  &trans    &trans  &trans  &trans  &trans  &trans
&kp F11  &kp F4  &kp F5  &kp F6  &trans    &trans  &trans  &trans  &trans  &trans
&kp F10  &kp F1  &kp F2  &kp F3  &trans    &trans  &trans  &trans  &trans  &trans
                         &trans  &trans    &trans  &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans     &kp HOME  &kp UP    &kp END    &trans
&trans  &trans  &trans  &trans  &trans    &kp PG_UP  &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&trans  &trans  &trans  &trans  &trans    &kp PG_DN  &trans    &trans    &trans     &trans
                        &trans  &trans    &trans     &trans
            >;
        };

        media {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_UP    &kp C_BRIGHTNESS_INC  &kp C_SLEEP
&trans  &trans  &trans  &trans  &trans    &trans  &kp C_PREVIOUS        &kp C_VOLUME_DOWN  &kp C_NEXT            &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans                &kp C_MUTE         &trans                &trans
                        &trans  &trans    &trans  &trans
            >;
        };
    };
};
